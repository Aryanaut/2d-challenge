Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 80; 80; 80
      Plane Cell Count: 40
    - Class: rviz_default_plugins/Map
      Name: Map (slam)
      Enabled: true
      Topic: {Value: /map, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Alpha: 0.7
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: false
      Topic: {Value: /global_costmap/costmap, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Alpha: 0.4
      Color Scheme: costmap
    - Class: rviz_default_plugins/PointCloud2
      Name: Virtual walls
      Enabled: true
      Topic: {Value: /virtual_walls, Depth: 1, Reliability Policy: Reliable}
      Style: Flat Squares
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 255; 0; 255
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Tile terrain kind (from the terrain classifier)
      Enabled: true
      Topic: {Value: /mission_manager/terrain_markers, Depth: 5, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: Tiles (blue visited, green to_visit, red blocked, purple unreachable) + trail + CHOSEN tile (orange)
      Enabled: true
      Topic: {Value: /mission_manager/tile_markers, Depth: 5, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: Tile descriptions
      Enabled: true
      Topic: {Value: /mission_manager/markers, Depth: 5, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Path
      Name: Route (3 waypoints + goal)
      Enabled: true
      Topic: {Value: /mission_manager/route, Depth: 5, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Color: 255; 128; 0
      Line Style: Billboards
      Line Width: 0.05
      Pose Style: Arrows
      Arrow Length: 0.12
      Alpha: 1
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Topic: {Value: /local_plan, Depth: 5}
      Color: 0; 255; 255
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/Pose
      Name: Current goal sent to Nav2
      Enabled: true
      Topic: {Value: /mission_manager/current_goal, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Color: 255; 25; 0
      Shape: Arrow
      Head Length: 0.3
      Head Radius: 0.15
      Shaft Length: 0.5
      Shaft Radius: 0.05
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic: {Value: /scan, Depth: 1, Reliability Policy: Best Effort}
      Size (m): 0.03
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Frame Timeout: 15
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down
      Scale: 40
      Target Frame: <Fixed Frame>
      Invert Z Axis: false
      X: 0
      Y: 0
Window Geometry:
  Height: 1000
  Width: 1500
