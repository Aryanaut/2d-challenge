+def _rotate(pts, yaw_deg, cx):
+    th = math.radians(yaw_deg)
+    R = np.array([[math.cos(th), -math.sin(th)], [math.sin(th), math.cos(th)]])
+    out = pts.copy()
+    out[:, :2] = (pts[:, :2] - [cx, 0]) @ R.T + [cx, 0]
+    return out
+
