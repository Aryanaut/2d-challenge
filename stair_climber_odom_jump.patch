+    obs = detect_stairs(pts, FLOOR_Z, CLOSE)
+    assert obs.detected, obs.reason
+    assert abs(math.degrees(obs.edge_yaw) - 8.0) < 2.5, math.degrees(obs.edge_yaw)
+    assert abs(obs.center_y - 0.12) < 0.08
