+# ---------------------------------------------------------------- front_wall_distance (24 Nov)
+def _box3(x0, x1, y0, y1, z0, z1, n=30):
+    import numpy as np
+    xs, ys, zs = np.meshgrid(np.linspace(x0, x1, n), np.linspace(y0, y1, n), np.linspace(z0, z1, 4))
+    return np.stack([xs.ravel(), ys.ravel(), zs.ravel()], axis=1)
+
+
+def test_wall_ahead_is_found():
+    from stair_climber.stair_detector import front_wall_distance
+    wall = _box3(0.8, 0.82, -0.5, 0.5, -0.39, 0.6)
+    assert abs(front_wall_distance(wall) - 0.8) < 0.03
+
