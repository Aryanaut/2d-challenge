+    def slippy(x):
+        a = EDGE - 0.1
+        for lim, nose in ((0.0, 0.0), (0.1, 12.0), (0.2, 25.0), (0.32, 10.0), (0.9, 35.0),
+                          (1.0, 10.0), (1.6, -35.0), (1.7, -13.0)):
+            if x < a + lim:
