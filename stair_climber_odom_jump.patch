+def test_stairs_are_not_a_wall():
+    import math
+    import numpy as np
+    from stair_climber.stair_detector import front_wall_distance
+    # arena stairs seen from the floor: top tread 0.51 m above the floor = 0.12 m above base_link
+    steps = np.vstack([_box3(0.6, 0.75, -0.5, 0.5, -0.39 + 0.195, -0.39 + 0.195),
+                       _box3(0.75, 0.9, -0.5, 0.5, -0.39 + 0.395, -0.39 + 0.395),
+                       _box3(0.9, 1.1, -0.5, 0.5, -0.39 + 0.51, -0.39 + 0.51)])
+    assert math.isinf(front_wall_distance(steps))
+
