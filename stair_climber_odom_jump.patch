+def test_recorded_run_profile_with_gait_sequence(monkeypatch):
+    """Pitch profile shaped like the manual run of 12 Nov (stairs_run2):
+    nose-up ~35 deg on the steps, ~10 deg once the front legs are on the top,
+    nose-down ~35 deg going down. Odom z did NOT follow the climb, so it is flat.
+    Gaits: H-Step up, flat across the top, Grip down; stop-and-go throughout."""
+    import test_state_machine as me
+    H_STEP, GRIP = 0x21010407, 0x21010402
+
+    def recorded(x):
+        a = EDGE - 0.1
+        if x < a:
+            return 0.0, 0.0
+        if x < a + 0.15:
+            return 12.0, 0.0
+        if x < a + 0.9:
+            return 35.0, 0.0
+        if x < a + 1.0:
+            return 10.0, 0.0
+        if x < a + 1.6:
+            return -35.0, 0.0
+        if x < a + 1.7:
+            return -13.0, 0.0
+        return 0.0, 0.0
+
+    monkeypatch.setattr(me, 'world', recorded)
+    sim = Sim(params(stair_gait_code=H_STEP, top_gait_code=FLAT, descend_gait_code=GRIP,
+                     use_odom_height=False, pulse_move_s=2.0, pulse_pause_s=1.0,
+                     climb_speed=0.06, descend_speed=0.05, platform_speed=0.05,
+                     climb_timeout=60.0, descend_timeout=60.0, stuck_window=12.0,
+                     max_pitch_deg=48.0))
+    cmd = sim.run(seconds=300)
+    assert cmd.state == State.DONE, (sim.sm.transitions, sim.sm.abort_reason)
+    assert states_visited(sim) == [
+        State.SEARCH, State.ALIGN, State.SWITCH_TO_STAIR_GAIT, State.APPROACH,
+        State.CLIMB_UP, State.SWITCH_TO_TOP_GAIT, State.TOP_PLATFORM,
+        State.SWITCH_TO_DESCEND_GAIT, State.DESCEND, State.CLEAR_BOTTOM,
+        State.SWITCH_TO_FLAT_GAIT, State.DONE]
+    assert sim.gaits == [H_STEP, FLAT, GRIP, FLAT]
