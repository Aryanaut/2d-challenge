+def blind(pts, lidar_h=0.515, beam_deg=21.6):
+    """Drop what the lidar cannot see: anything below its lowest beam."""
+    h = pts[:, 2] - FLOOR_Z
+    return pts[h >= lidar_h - pts[:, 0] * math.tan(math.radians(beam_deg))]
+
+
+def test_close_stairs_detected_without_floor():
+    pts = blind(arena_stairs(edge_x=0.6))
+    assert not detect_stairs(pts, FLOOR_Z, DetectorParams(max_step_height=0.24)).detected
+    obs = detect_stairs(pts, FLOOR_Z, CLOSE)
+    assert obs.detected and obs.close, obs.reason
+    assert abs(obs.distance - 0.6) < 0.15        # nearest visible face minus the offset
+    assert abs(math.degrees(obs.edge_yaw)) < 2.0
+    assert abs(obs.center_y) < 0.06
+
