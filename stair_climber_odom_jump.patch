+# ---------------------------------------------------------------- odometry jumps + AI already on (24 Nov)
+def _frame_jump_spy(sim, after_state, delay, jump_xy=(-3.4, -0.2), jump_yaw_deg=90.0):
+    """From `delay` s after entering after_state, odometry is reported in a new frame (stairs_ai3: ~2 s after
+    Enter AI, x 4.03 -> 0.59). Returns the list the CROSS_AI wz commands are collected in."""
+    orig = sim.sm.update
+    st = {'t0': None}
+    wz = []
+    a = math.radians(jump_yaw_deg)
+
+    def spy(o):
+        if sim.sm.state == after_state and st['t0'] is None:
+            st['t0'] = o.t
+        if st['t0'] is not None and o.t - st['t0'] >= delay:
+            x, y = o.x, o.y
+            o.x = jump_xy[0] + math.cos(a) * x - math.sin(a) * y
+            o.y = jump_xy[1] + math.sin(a) * x + math.cos(a) * y
+            o.yaw = o.yaw + a
+        c = orig(o)
+        if c.state == State.CROSS_AI:
+            wz.append(c.wz)
+        return c
+    sim.sm.update = spy
+    return wz
+
